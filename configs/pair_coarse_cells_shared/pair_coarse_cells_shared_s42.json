{
  "experiment_name": "pair_coarse_cells_shared",
  "seed": 42,
  "representation": "member_coarse_cells",
  "member_features": [
    "45_core_cells"
  ],
  "model": {
    "name": "shared_member_pair_mlp",
    "member_width": 45,
    "member_encoder": [45, 32, 16],
    "member_embedding_width": 16,
    "fusion": "symmetric_sum_absolute_difference",
    "pair_head": [32, 32, 16, 1],
    "activation": "leaky_relu_0.01",
    "initialization": "pytorch_default",
    "output_classes": 1,
    "trainable_parameters": 3601
  },
  "target": "both_members_tau_labelled",
  "loss": {"name": "bce", "pair_weighting": "equal"},
  "optimizer": {"name": "adam", "learning_rate": 0.001},
  "batch_size": 256,
  "epochs": 20,
  "checkpoint_each_epoch": true,
  "event_aggregation": "maximum_pair_score",
  "target_event_fpr": 0.005
}
