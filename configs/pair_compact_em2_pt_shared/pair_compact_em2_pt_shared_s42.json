{
  "experiment_name": "pair_compact_em2_pt_shared",
  "seed": 42,
  "representation": "member_compact_em2_pt",
  "member_features": [
    "em2_max1",
    "em2_max2",
    "em2_max_neighbors_sum",
    "em2_width",
    "em2_normalized_width",
    "em2_best_3x3_fraction",
    "em2_maxratio_approx",
    "em2_top3_window1_fraction",
    "em2_top3_window2_fraction",
    "em2_top3_window3_fraction",
    "em2_top3_window12_sqdist",
    "em2_top3_window13_sqdist",
    "em2_top3_window23_sqdist",
    "em2_top2_3x3_sqdist",
    "em2_6x6_maxdist",
    "em2_outside_best_3x3_over_pt",
    "measured_tob_pt"
  ],
  "model": {
    "name": "shared_member_pair_mlp",
    "member_width": 17,
    "member_encoder": [17, 32, 16],
    "member_embedding_width": 16,
    "fusion": "symmetric_sum_absolute_difference",
    "pair_head": [32, 32, 16, 1],
    "activation": "leaky_relu_0.01",
    "initialization": "pytorch_default",
    "output_classes": 1,
    "trainable_parameters": 2705
  },
  "target": "both_members_tau_labelled",
  "loss": {"name": "bce", "pair_weighting": "equal"},
  "optimizer": {"name": "adam", "learning_rate": 0.001},
  "batch_size": 256,
  "epochs": 20,
  "checkpoint_each_epoch": true,
  "event_aggregation": "maximum_pair_score",
  "target_event_fpr": 0.005
}
