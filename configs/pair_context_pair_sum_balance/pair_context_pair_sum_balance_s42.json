{
  "experiment_name": "pair_context_pair_sum_balance",
  "seed": 42,
  "representation": "high_resolution_em2_context",
  "representation_details": {
    "member_image": "12x12_em2",
    "member_scalars": [
      "45_core_cells",
      "em2_best_3x3_fraction"
    ],
    "context_features": [
      "pair_sum_pt",
      "pair_balance"
    ],
    "context_definition": "event second-highest pT plus pair sum and balance; member pT removed"
  },
  "context_features": [
    "pair_sum_pt",
    "pair_balance"
  ],
  "include_member_pt": false,
  "model": {
    "name": "shared_member_high_resolution_em2",
    "member_scalar_width": 46,
    "context_width": 3,
    "member_embedding_width": 16,
    "pair_head": [
      35,
      32,
      16,
      1
    ],
    "trainable_parameters": 4369
  },
  "target": "both_members_tau_labelled",
  "loss": {
    "name": "bce",
    "pair_weighting": "power_law_pminus1_member_min",
    "weight_coordinate": "member_min_truth_pt_gev"
  },
  "optimizer": {
    "name": "adam",
    "learning_rate": 0.001
  },
  "batch_size": 256,
  "epochs": 20,
  "checkpoint_each_epoch": true,
  "event_aggregation": "maximum_pair_score",
  "target_event_fpr": 0.005
}
