{
  "experiment_name": "pair_pt_control",
  "seed": 123,
  "representation": "pair_pt",
  "input_order": ["tob_pt_max", "tob_pt_min"],
  "model": {"name": "pair_pt_mlp", "layers": [2, 8, 1], "activation": "relu"},
  "target": "both_members_tau_labelled",
  "loss": {"name": "bce", "pair_weighting": "equal"},
  "optimizer": {"name": "adam", "learning_rate": 0.001},
  "batch_size": 256,
  "epochs": 20,
  "checkpoint_each_epoch": true,
  "event_aggregation": "maximum_pair_score",
  "target_event_fpr": 0.005
}
